# Squad Hub SaaS server (app.squadhub.in). Copy to server/.env for local dev.
PORT=4000
NODE_ENV=development

# The SaaS's OWN Supabase project (never the internal Hub project).
SUPABASE_URL=https://your-saas-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret

# Cloudflare R2 (uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=squadhub-saas-files
R2_PUBLIC_URL=

# Public web origin (CORS + links). Production: https://app.squadhub.in
CLIENT_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Squad Hub (internal) bridge — docs/bridge-contract.md. Unset secret = bridge off.
HUB_API_URL=http://localhost:4100
SAAS_BRIDGE_SECRET=

# SquadHire SSO + password adoption (business / talent sign-in)
SQUADHIRE_WEBHOOK_URL=
SQUADHIRE_WEBHOOK_SECRET=
SQUADHIRE_CALLBACK_SECRET=
SQUADHIRE_SSO_REDIRECT_URIS=

# Web Push (optional)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@example.com

# Huddles (LiveKit, optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Set on any secondary instance so crons don't double-fire.
DISABLE_CRONS=false
