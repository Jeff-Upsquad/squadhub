# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (use Supabase's JWT secret from Settings > API)
JWT_SECRET=your-jwt-secret

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=squadhub-files
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK (for native Android FCM push — Squad Chat).
# Paste the full JSON of your Firebase service-account key as one line.
# If unset, FCM sends are skipped (Expo pushes still work).
FIREBASE_SERVICE_ACCOUNT_JSON=

# SquadHire (Profiles) integration — all three are optional; when unset the
# outbound webhook is a no-op and the inbound callback endpoint returns 503.
# Keep SQUADHIRE_WEBHOOK_SECRET in sync with Profiles' SQUADHUB_WEBHOOK_SECRET,
# and SQUADHIRE_CALLBACK_SECRET in sync with Profiles' SQUADHUB_CALLBACK_SECRET.
SQUADHIRE_WEBHOOK_URL=http://localhost:5000/api/webhooks/squadhub/cards
SQUADHIRE_WEBHOOK_SECRET=
SQUADHIRE_CALLBACK_SECRET=

# "Sign in with SquadHub" SSO into SquadHire's /staff portal. Comma-separated
# exact-match allowlist of SquadHire staff callback PAGE URLs we may redirect
# one-time codes to. Reuses SQUADHIRE_CALLBACK_SECRET for the server-to-server
# token exchange. Leave empty to disable SSO. Example (local staff dev port):
SQUADHIRE_SSO_REDIRECT_URIS=http://localhost:3005/staff/sso/callback

# Candidates mini app — proxies to SquadHire's /api/integrations/squadhub/
# candidates/* surface (reuses SQUADHIRE_WEBHOOK_URL origin + SQUADHIRE_WEBHOOK_SECRET).
# Set to false for an instant kill switch without a deploy. Default: true.
CANDIDATES_PROXY_ENABLED=true

# SquadHire Discover — proxies the Partner app's Discover tab to SquadHire's
# business discover API (Categories → Profiles marketplace). Requires a
# service-account JWT with business role. When unset, Discover returns 503.
SQUADHIRE_API_URL=https://squadhire.upsquadconnect.com/api
SQUADHIRE_BUSINESS_TOKEN=

# Anthropic — used by the cash book receipt analyzer (POST /cashbook/analyze-receipts).
# When unset, the endpoint returns 503 so the rest of the API still boots.
ANTHROPIC_API_KEY=

# upsquad admin API — proxies inbound subscription requests from the upsquad
# pricing page so admins can publish them as subscription cards. UPSQUAD_API_TOKEN
# must match upsquad server's ADMIN_API_TOKEN. When unset, the proxy endpoints
# return 503 and the From-Requests admin tab is empty.
UPSQUAD_API_URL=http://localhost:3100
UPSQUAD_API_TOKEN=

# SquadBooks integration — admins assign per-user SquadBooks access from the admin
# panel (/admin/squadbooks-access), which proxies to SquadBooks' /api/admin/access.
# SQUADBOOKS_ADMIN_API_KEY must match SquadBooks' own SQUADBOOKS_ADMIN_API_KEY.
# When unset, the /admin/squadbooks-access endpoints return 503.
SQUADBOOKS_URL=https://books.squadhub.in
SQUADBOOKS_ADMIN_API_KEY=

# Web Push — browser notifications for the installable PWA (squadhub.in).
# Generate a keypair once with:  npx web-push generate-vapid-keys
# The public key is also served to the browser at GET /push/vapid-public-key.
# When unset, web push sends are skipped (the rest of the API still boots).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@squadhub.in
