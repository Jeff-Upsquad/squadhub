[Unit]
Description=Verify local PostgreSQL offsite recovery
After=network-online.target docker.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/squadhub/tools/postgres/backup_local.py restore-test --config /etc/squadhub-postgres-backup/.env
TimeoutStartSec=45min
Nice=10
