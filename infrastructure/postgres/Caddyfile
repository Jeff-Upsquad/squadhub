{
  admin off
  auto_https off
}
:8080 {
  # Optional app trial, attached to the private data network with this alias.
  handle_path /trial-api/* {
    reverse_proxy app-trial:4000
  }
  handle_path /auth/v1/* {
    reverse_proxy identity:4101
  }
  handle_path /rest/v1/* {
    reverse_proxy rest:3000
  }
  handle /health {
    reverse_proxy identity:4101
  }
  handle {
    respond "Not found" 404
  }
}
