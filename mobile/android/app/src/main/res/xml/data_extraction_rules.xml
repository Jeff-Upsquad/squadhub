<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="squad_chat_auth_encrypted.xml" />
        <exclude domain="database" path="squad_chat.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="squad_chat_auth_encrypted.xml" />
        <exclude domain="database" path="squad_chat.db" />
    </device-transfer>
</data-extraction-rules>
