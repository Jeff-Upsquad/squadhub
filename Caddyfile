crm-api.squadhub.in {
	reverse_proxy crm-server:4100
}
# Append to SquadHub's /root/squadhub/Caddyfile (alongside the existing
# crm.squadhub.in / crm-api.squadhub.in blocks for the original Squad CRM),
# then reload Caddy:
#   docker exec squadhub-caddy caddy reload --config /etc/caddy/Caddyfile
#
# Adds two new subdomains for the SquadHire CRM instance. The original
# Squad CRM containers (crm-server / crm-web) are unaffected.
#
# If you'd prefer a different domain (e.g. crm.squadhire.com), replace the
# host names below — the container hostnames (shcrm-web, shcrm-server) stay
# the same since they're docker network identifiers.

shcrm.squadhub.in {
	reverse_proxy shcrm-web:3100
}

shcrm-api.squadhub.in {
	reverse_proxy shcrm-server:4100
}

www.rioconnect.in {
	redir https://rioconnect.in{uri} permanent
}

rioconnect.in {
	encode zstd gzip
	root * /srv/rioconnect
	@html path *.html /
	header @html Cache-Control "no-cache, no-store, must-revalidate"
	@static path /assets/* *.css *.js
	header @static Cache-Control "public, max-age=604800"
	try_files {path} /index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}

books.squadhub.in {
	reverse_proxy squadbooks:3000
}

clips.squadhub.in {
	# The clips app only whitelists squadhub.in + squadhire.upsquadconnect.com
	# in its own frame-ancestors CSP, so the UpSquad marketing site can't embed
	# a shared clip. Override the CSP at the edge for the embeddable routes
	# (/embed/* and /share/*) to also allow the UpSquad domains. Everything else
	# proxies through untouched so the app's own CSP still applies.
	@embeddable path /embed/* /share/*
	handle @embeddable {
		reverse_proxy host.docker.internal:3200 {
			header_down Content-Security-Policy "frame-ancestors 'self' https://squadhub.in https://squadhire.upsquadconnect.com https://www.upsquadconnect.com https://upsquadconnect.com"
		}
	}
	handle {
		reverse_proxy host.docker.internal:3200
	}
}

appsquad.upsquadconnect.com {
	encode gzip
	reverse_proxy appsquad-web:80
}

squadpayroll.upsquadconnect.com {
  @sub path /api/subscriptions /api/subscriptions/* /api/admin/* /api/webhooks/*
  handle @sub {
    reverse_proxy host.docker.internal:3022
  }
  handle /api/* {
    reverse_proxy host.docker.internal:3021
  }
  @portal path /portal /portal/*
  handle @portal {
    root * /srv/attendanceapp/squadpayroll
    rewrite * /portal/index.html
    file_server
  }
  @login path /login /login/*
  handle @login {
    root * /srv/attendanceapp/squadpayroll
    rewrite * /app.html
    file_server
  }
  handle {
    encode gzip
    root * /srv/attendanceapp/squadpayroll
    @html path *.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"
    try_files {path} /index.html
    file_server
  }
}

