squadhub.in {
	# CRM embeds two real modules by iframe — the ChatPanel at /embed/crm-chat
	# and the Requirement Cards hub at /embed/cards. Override CSP so
	# crm.squadhub.in (and local CRM) can frame them; everything else proxies
	# through with the app's default headers.
	@crm_chat_embed path /embed/crm-chat /embed/crm-chat/* /embed/cards /embed/cards/*
	handle @crm_chat_embed {
		reverse_proxy web:3000 {
			header_down Content-Security-Policy "frame-ancestors 'self' https://crm.squadhub.in http://localhost:3100 http://127.0.0.1:3100"
			header_down -X-Frame-Options
		}
	}
	# Partner Portal — static mini app (partner-portal/ in the repo) served at
	# /partners from the host dir mounted into caddy as /srv/partner-portal.
	# No-cache so file updates land immediately; hash-routed SPA, hence the
	# try_files fallback to index.html. The bare path redirects to /partners/
	# so relative asset URLs resolve under /partners/ instead of the domain root.
	@partners_root path /partners
	redir @partners_root /partners/ 308
	@partners path /partners/*
	handle @partners {
		encode zstd gzip
		root * /srv/partner-portal
		uri strip_prefix /partners
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
}

admin.squadhub.in {
	reverse_proxy admin:3001
}

api.squadhub.in {
	handle /downloads/* {
		root * /srv/cashbook-downloads
		uri strip_prefix /downloads

		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition "attachment; filename=cashbook-latest.apk"

		file_server {
			index index.html
		}
	}

	# Sideloaded APKs for the native partner app's in-app updater.
	# Drop release APKs in /var/www/partner-downloads on the host; the
	# version manifest (GET /partner-app/version) points apk_url here.
	handle /partner-downloads/* {
		root * /srv/partner-downloads
		uri strip_prefix /partner-downloads

		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive

		file_server
	}

	# Sideloaded APKs for the SquadHub Internal app's in-app updater.
	handle /internal-downloads/* {
		root * /srv/internal-downloads
		uri strip_prefix /internal-downloads

		@internal_apk path *.apk
		header @internal_apk Content-Type application/vnd.android.package-archive
		header @internal_apk Content-Disposition "attachment"

		file_server
	}

	# Sideloaded APKs for the Squad Hub Business app's in-app updater.
	# Drop release APKs in /var/www/business-downloads on the host; the
	# version manifest (GET /business-app/version) points apk_url here.
	handle /business-downloads/* {
		root * /srv/business-downloads
		uri strip_prefix /business-downloads

		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive

		file_server
	}

	reverse_proxy server:4000
}

