# SquadHub Deployment & WAT Framework Configuration
# Copy this file to .env and fill in actual values
# Never commit .env to version control (it's gitignored)

# ==== Deployment URLs ====
# Update these to match your domain
CLIENT_URL=https://squadhub.in
ADMIN_URL=https://admin.squadhub.in

# ==== Database (Supabase) ====
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==== Tools Credentials ====
# Add credentials needed by Python tools in tools/
# Examples:
# GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json
# API_KEY_NAME=your-api-key-value
