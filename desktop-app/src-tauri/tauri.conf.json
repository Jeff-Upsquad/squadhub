{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SquadHub",
  "version": "0.1.0",
  "identifier": "in.squadhub.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SquadHub",
        "url": "https://squadhub.in",
        "width": 1280,
        "height": 832,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://squadhub.in/downloads/app/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNDlFNkM3MzhCMzMzQzIKUldUQ003TTR4K1pKdzY0dFRDcFlJV0QzR0VNZXlkSjVXRG1lQ1FqbklMS3o4Y3daZkN0RXFDQ0IK"
    }
  }
}
