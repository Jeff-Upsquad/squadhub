{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-docs/main/references/config.schema.json",
  "productName": "SquadHub",
  "version": "0.1.5",
  "identifier": "in.squadhub.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "SquadHub",
        "width": 380,
        "height": 480,
        "resizable": false,
        "center": true,
        "visible": true,
        "decorations": true
      },
      {
        "label": "quickadd",
        "title": "Quick Add Task",
        "width": 560,
        "height": 560,
        "resizable": false,
        "transparent": true,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://squadhub.in/downloads/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNDlFNkM3MzhCMzMzQzIKUldUQ003TTR4K1pKdzY0dFRDcFlJV0QzR0VNZXlkSjVXRG1lQ1FqbklMS3o4Y3daZkN0RXFDQ0IK"
    }
  }
}
